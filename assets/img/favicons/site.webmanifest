---
layout: null
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | strip_newlines | jsonify }},
  "icons": [
    {
      "src": "{{ '/assets/img/favicons/web-app-manifest-192x192.png' | relative_url }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{ '/assets/img/favicons/web-app-manifest-512x512.png' | relative_url }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "start_url": "{{ '/' | relative_url }}",
  "theme_color": "#002769",
  "background_color": "#ffffff",
  "display": "standalone"
}
